# Backend (prefix NV_). Placeholders only: never commit real values.
NV_DATA_DIR=./var                  # datasets/, runs/, checkpoints/, artifacts/ live here
NV_DEVICE=auto                     # auto | cpu | cuda
NV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NV_MAX_UPLOAD_MB=200
NV_MAX_INPLANE_DIM=320
NV_MAX_DEPTH=400
NV_INFERENCE_TIMEOUT_S=600
NV_ARTIFACT_TTL_MINUTES=60         # retention of generated results; uploads are never kept
NV_RATE_LIMIT_PER_MINUTE=30
NV_TRAINING_ENABLED=true           # set false on public deployments
NV_CHECKPOINT_PATH=                # optional: explicit path, default <data_dir>/checkpoints/best.pt
NV_CONFIDENCE_HIGH=0.90            # used until validation-derived thresholds exist
NV_CONFIDENCE_MEDIUM=0.70
NV_LOG_LEVEL=INFO

# Frontend (build time)
VITE_API_URL=http://localhost:8000
